# Shared editor settings. IntelliJ IDEA honours these out of the box.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 90

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
