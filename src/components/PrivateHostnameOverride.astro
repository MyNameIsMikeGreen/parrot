---
/**
 * Lets a visitor override the hostname used by "private network only" links.
 *
 * Those links point at `pi`, a name that only resolves on the home network's
 * own DNS/mDNS. Some networks (a phone off Wi-Fi, a guest network with strict
 * mDNS filtering, a VPN) never see that name resolve at all, even though the
 * service is genuinely reachable at some other address. This widget lets a
 * visitor supply the hostname or IP address that works for them instead.
 *
 * It is deliberately unobtrusive: collapsed by default, tucked under the
 * private-network section it affects, and invisible in effect until someone
 * opens it and types something. Nothing changes for the visitor who never
 * touches it.
 */
---

<div class="hostname-override">
  <span class="hostname-override__intro">
    <button
      type="button"
      class="hostname-override__info"
      aria-describedby="hostname-override-popover"
    >
      <span aria-hidden="true">i</span>
      <span class="visually-hidden">What does this do?</span>
    </button>
    <span id="hostname-override-popover" class="hostname-override__popover" role="note">
      The links above point to <code>pi</code>, a name only devices on my home network can
      resolve. If your network can't resolve it, enter the hostname or IP address that
      does work for you instead.
    </span>
  </span>
  <details class="hostname-override__details">
    <summary class="hostname-override__summary"
      >Can't reach these? Set a custom host</summary
    >
    <div class="hostname-override__panel">
      <label class="hostname-override__label" for="hostname-override-input">
        Hostname or IP address
      </label>
      <div class="hostname-override__row">
        <input
          type="text"
          id="hostname-override-input"
          class="hostname-override__input"
          placeholder="pi"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="hostname-override-clear"
          class="hostname-override__clear"
        >
          Clear
        </button>
      </div>
      <p
        class="hostname-override__status"
        id="hostname-override-status"
        aria-live="polite"
      >
      </p>
    </div>
  </details>
</div>

<script is:inline src="/scripts/private-hostname-override.js" defer></script>
